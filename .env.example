# Settings for docker-compose.yml (self-hosting). Copy to .env and fill in.
# Every variable the services accept is documented in apps/backend/.env.example
# and apps/runner/.env.example; this file lists the ones compose passes through.

# Required. The address people open, with no path. It is built into the web
# app, so after changing it run `docker compose up -d --build`.
WEB_ORIGIN=http://localhost:8080

# Required secrets. Generate each with: openssl rand -hex 32
BETTER_AUTH_SECRET=
RUNNER_TOKEN=
POSTGRES_PASSWORD=

# Ports published on this machine. Defaults 8080 and 8443.
# HTTP_PORT=8080
# HTTPS_PORT=8443
# What Caddy serves. Default :80 (plain HTTP). Set a domain name, such as
# learn.example.com, for automatic HTTPS; publish 80 and 443 for that.
# SITE_ADDRESS=:80

# Addresses given the admin role when they sign up. Comma-separated.
# ADMIN_EMAILS=

# Isolation for learners' code. Unset: plain Docker, for people you trust.
# For a public instance install gVisor and set runsc.
# RUNNER_DOCKER_RUNTIME=runsc
# Runs at once. Default 2.
# RUNNER_MAX_CONCURRENT=2

# Optional services: each feature switches itself on when configured.
# Email (verification and password reset): none | resend | smtp. Default none.
# EMAIL_DRIVER=none
# EMAIL_FROM=
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Google sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Paper content on Cloudflare R2 instead of the storage volume.
# STORAGE_DRIVER=fs
# R2_ACCOUNT_ID=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# With R2, also the public bucket for avatars and its URL; AVATAR_ORIGIN is that URL's
# origin, so the site's image policy allows it.
# R2_PUBLIC_BUCKET=
# R2_PUBLIC_URL=
# AVATAR_ORIGIN=

# Limits (defaults in apps/backend/.env.example).
# ALLOW_SIGNUPS=true
# REQUIRE_EMAIL_VERIFICATION=true
# RUNS_PER_DAY=100
# RUNS_PER_MINUTE=10
# GLOBAL_RUNS_PER_DAY=20000
# MUTATIONS_PER_MINUTE=60
# LOG_LEVEL=info
