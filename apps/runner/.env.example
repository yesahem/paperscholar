# The bundled runner service (docs/specs/13-self-hosting.md §5). In
# docker-compose.yml these come from the root .env; for a run outside Docker,
# copy this file to apps/runner/.env.

# Required. Shared secret the backend sends as a bearer token; set the same
# value as RUNNER_TOKEN in the backend. At least 32 characters: openssl rand -hex 32
RUNNER_TOKEN=

# Port to listen on. Default 8798. Never publish it outside the internal network.
# PORT=8798

# debug | info | warn | error. Default info.
# LOG_LEVEL=info

# Sandbox images, built with `bun run runner:images`.
# Defaults paperscholar-sandbox-numpy and paperscholar-sandbox-torch.
# RUNNER_IMAGE_NUMPY=paperscholar-sandbox-numpy
# RUNNER_IMAGE_TORCH=paperscholar-sandbox-torch

# A sandboxed container runtime installed on the host, such as gVisor's runsc.
# Unset: Docker's default runtime, which shares the host kernel and is suitable
# only for people you trust. Set it for an instance open to the public.
# RUNNER_DOCKER_RUNTIME=runsc

# Containers running at once (default 2), and runs allowed to wait for one
# (default 20; beyond that the service answers 503).
# RUNNER_MAX_CONCURRENT=2
# RUNNER_MAX_QUEUE=20

# CPUs per run container. Default 1.
# RUNNER_CPUS=1

# The docker command, and the daemon to talk to. Defaults: docker on PATH, and
# the default socket (/var/run/docker.sock).
# DOCKER_BIN=docker
# DOCKER_HOST=

# Search path for the docker command. Default /usr/local/bin:/usr/bin:/bin.
# PATH=
