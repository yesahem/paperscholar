# Copy to apps/cms/.env for local development. Next.js loads it automatically.
# The CMS holds no secrets; anything prefixed NEXT_PUBLIC_ is public.
# API_ORIGIN, NEXT_PUBLIC_CMS_URL, NEXT_PUBLIC_SITE_URL and UPLOAD_ORIGIN are fixed when
# the CMS is built.

# Required. Server-only. Next.js proxies /api/* to this origin; the browser never sees it.
# Must match the backend's PORT (apps/backend/.env).
API_ORIGIN=http://localhost:8797

# Required. This app's own public URL, used for metadata. The backend's CMS_ORIGIN
# (apps/backend/.env) must be the same origin.
NEXT_PUBLIC_CMS_URL=http://localhost:3001

# Required. The learner site (apps/web), for links to published papers and to the pages
# where accounts are made and passwords reset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Only when the backend keeps files in R2 (STORAGE_DRIVER=r2): the origin of its
# S3 endpoint, such as https://<account>.r2.cloudflarestorage.com, so maintainers'
# browsers may upload PDFs to it directly (the R2 bucket needs a CORS rule allowing PUT
# from this site). Leave blank otherwise: with the fs driver uploads go through this site.
UPLOAD_ORIGIN=
