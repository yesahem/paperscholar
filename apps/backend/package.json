{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "start": "bun src/main.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "content:sync": "bun run src/cli/content-sync.ts",
    "content:export": "bun run src/cli/content-export.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@repo/content": "*",
    "@repo/db": "*",
    "@repo/shared": "*",
    "@repo/storage": "*",
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "1.3.14",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
