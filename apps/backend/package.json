{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "start": "bun src/main.ts",
    "worker": "bun src/worker.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "content:sync": "bun run src/cli/content-sync.ts",
    "content:export": "bun run src/cli/content-export.ts",
    "content:status": "bun run src/cli/content-status.ts",
    "admin:grant": "bun run src/cli/admin-grant.ts",
    "admin:password": "bun run src/cli/admin-password.ts",
    "auth:schema": "auth generate --config scripts/auth-schema.config.ts --output ../../packages/db/src/schema/auth.ts --yes && bun scripts/auth-schema-timestamptz.ts ../../packages/db/src/schema/auth.ts && prettier --write ../../packages/db/src/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.22",
    "@hono/zod-validator": "0.9.1",
    "@repo/content": "*",
    "@repo/db": "*",
    "@repo/runner": "*",
    "@repo/shared": "*",
    "@repo/storage": "*",
    "@vercel/functions": "3.10.0",
    "better-auth": "1.7.22",
    "hono": "4.13.18",
    "nodemailer": "10.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "1.3.14",
    "@types/nodemailer": "8.0.2",
    "auth": "1.7.22",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
