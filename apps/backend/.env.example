# Copy to apps/backend/.env for local development. Bun loads it automatically.

# Public origin of the web app, without a path. Used for origin checks and auth (M3).
WEB_ORIGIN=http://localhost:3000

# Port for the Bun.serve entry (src/main.ts). Ignored by the serverless entry.
PORT=8797

# debug | info | warn | error
LOG_LEVEL=info

# development | test | production
NODE_ENV=development

# Postgres. Content commands need it for the lock that serialises content writes;
# the server needs it from M3. Matches docker-compose.dev.yml.
DATABASE_URL=postgres://paperscholar:paperscholar@localhost:54330/paperscholar

# Where paper content and uploads live: fs (a local folder) or r2 (Cloudflare R2).
# Serverless hosting must use r2.
STORAGE_DRIVER=fs
# With fs: the folder, relative to apps/backend.
STORAGE_FS_PATH=.storage
# With r2: the account (or an explicit S3 endpoint, for other S3-compatible stores),
# an API token limited to the bucket, and the private bucket's name.
# R2_ACCOUNT_ID=
# R2_ENDPOINT=
# Signing region: "auto" for R2. Other S3-compatible stores usually want e.g. us-east-1.
# R2_REGION=auto
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Reported by GET /api/health. Defaults to the deployment's git commit, else "dev".
# APP_VERSION=
