# Copy to apps/backend/.env for local development. Bun loads it automatically.

# Public origin of the web app, without a path. Required. Used as the auth base URL,
# for origin checks, and in links inside emails.
WEB_ORIGIN=http://localhost:3000

# Port for the Bun.serve entry (src/main.ts). Ignored by the serverless entry. Default 8797.
PORT=8797

# debug | info | warn | error. Default info.
LOG_LEVEL=info

# development | test | production. Default development.
NODE_ENV=development

# Postgres. Required: accounts and sessions live here, and content commands use it for
# the lock that serialises content writes. Matches docker-compose.dev.yml.
DATABASE_URL=postgres://paperscholar:paperscholar@localhost:54330/paperscholar

# ── Accounts (docs/specs/06-auth.md) ──────────────────────────────────────────────

# Required. Signs session cookies and tokens; at least 32 characters.
# Generate one with: openssl rand -base64 32. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Comma-separated addresses that become admins when they sign up (after verifying,
# if this instance verifies emails). Read only at sign-up. Default: none.
# ADMIN_EMAILS=you@example.com

# false makes the instance private: nobody can create an account. Default true.
# ALLOW_SIGNUPS=true

# With an email driver, unverified users cannot run code until they confirm their
# address. false turns that off. Has no effect without an email driver. Default true.
# REQUIRE_EMAIL_VERIFICATION=true

# Sign-in, sign-up and password-reset requests allowed per client address per window.
# Defaults 10 and 600 (10 per 10 minutes).
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=600

# The header that carries the browser's address. The web app's proxy (or your hosting
# platform) must set it and overwrite any value the client sent. Default x-forwarded-for.
# CLIENT_IP_HEADER=x-forwarded-for
# Comma-separated proxy addresses or CIDR ranges allowed to append to that header,
# when it may hold a chain of addresses. Default: none (only single addresses are used).
# TRUSTED_PROXIES=

# Google sign-in. Set both to enable it; leave both unset to hide it.
# Authorised redirect URI: ${WEB_ORIGIN}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Email (docs/specs/06-auth.md §5) ──────────────────────────────────────────────

# none | log | resend | smtp. Default: log in development, none elsewhere.
# log prints each email, links included, to the console; refused in production.
# none switches off email verification and password reset by email
# (reset a password with `bun run admin:password <email>`).
# EMAIL_DRIVER=log

# Sender address, required for resend and smtp, e.g. PaperScholar <no-reply@example.com>.
# EMAIL_FROM=

# Required for resend.
# RESEND_API_KEY=

# smtp: SMTP_HOST is required. Port default 587; SMTP_SECURE=true for TLS from the
# first byte (usually port 465), otherwise STARTTLS. User and password go together.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ── Content and storage ───────────────────────────────────────────────────────────

# Where paper content and uploads live: fs (a local folder) or r2 (Cloudflare R2).
# Serverless hosting must use r2. Default fs.
STORAGE_DRIVER=fs
# With fs: the folder, relative to apps/backend. Default .storage.
STORAGE_FS_PATH=.storage
# With r2: the account (or an explicit S3 endpoint, for other S3-compatible stores),
# an API token limited to the bucket, and the private bucket's name.
# R2_ACCOUNT_ID=
# R2_ENDPOINT=
# Signing region: "auto" for R2. Other S3-compatible stores usually want e.g. us-east-1.
# R2_REGION=auto
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Runs each user may start per day, published by GET /api/v1/config. Default 100.
# RUNS_PER_DAY=100

# Reported by GET /api/health. Defaults to the deployment's git commit, else "dev".
# APP_VERSION=
