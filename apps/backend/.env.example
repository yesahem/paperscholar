# Copy to apps/backend/.env for local development. Bun loads it automatically.
#
# Every variable the backend reads is listed here. A blank value counts as unset, so
# the default applies (or the feature stays off). Variables marked "Required" must be
# filled in before the backend starts.

# ── Core ──────────────────────────────────────────────────────────────────────────

# Required. Public origin of the web app, without a path. Used as the auth base URL,
# for origin checks, and in links inside emails.
WEB_ORIGIN=http://localhost:3000

# Public origin of the CMS (apps/cms), without a path. Optional, but the paper pipeline is
# operated only from the CMS, so set it wherever the pipeline is on. It becomes a trusted
# origin for sign-in, and sessions made from it are for maintainers and admins only
# (docs/specs/14-cms.md §3). Default: none.
CMS_ORIGIN=http://localhost:3001

# Port for the Bun.serve entry (src/main.ts). Ignored by the serverless entry. Default 8797.
PORT=8797

# debug | info | warn | error. Default info.
LOG_LEVEL=info

# development | test | production. Default development.
NODE_ENV=development

# Required. Postgres: accounts and sessions live here, and content commands use it for
# the lock that serialises content writes. Matches docker-compose.dev.yml.
DATABASE_URL=postgres://paperscholar:paperscholar@localhost:54330/paperscholar

# Reported by GET /api/health. Defaults to the deployment's git commit, else "dev".
APP_VERSION=

# ── Accounts (docs/specs/06-auth.md) ──────────────────────────────────────────────

# Required. Signs session cookies and tokens; at least 32 characters.
# Generate one with: openssl rand -base64 32. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Comma-separated addresses that become admins when they sign up (after verifying,
# if this instance verifies emails). Read only at sign-up. Default: none.
ADMIN_EMAILS=

# false makes the instance private: nobody can create an account. Default true.
ALLOW_SIGNUPS=true

# With an email driver, unverified users cannot run code until they confirm their
# address. false turns that off. Has no effect without an email driver. Default true.
REQUIRE_EMAIL_VERIFICATION=true

# Sign-in, sign-up and password-reset requests allowed per client address per window.
# Defaults 10 and 600 (10 per 10 minutes).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=600

# The header that carries the browser's address. The web app's proxy (or your hosting
# platform) must set it and overwrite any value the client sent. Default x-forwarded-for.
CLIENT_IP_HEADER=x-forwarded-for
# Comma-separated proxy addresses or CIDR ranges allowed to append to that header,
# when it may hold a chain of addresses. Default: none (only single addresses are used).
TRUSTED_PROXIES=

# Google sign-in. Set both to enable it; leave both blank to hide it.
# Authorised redirect URI: ${WEB_ORIGIN}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (docs/specs/06-auth.md §5) ──────────────────────────────────────────────

# none | log | resend | smtp. Default: log in development, none elsewhere.
# log prints each email, links included, to the console; refused in production.
# none switches off email verification and password reset by email
# (reset a password with `bun run admin:password <email>`).
EMAIL_DRIVER=log

# Sender address, required for resend and smtp, e.g. PaperScholar <no-reply@example.com>.
EMAIL_FROM=

# Required when EMAIL_DRIVER is resend.
RESEND_API_KEY=

# smtp: SMTP_HOST is required. Port default 587; SMTP_SECURE=true for TLS from the
# first byte (usually port 465), otherwise STARTTLS. User and password go together.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ── Content and storage ───────────────────────────────────────────────────────────

# Where paper content and uploads live: fs (a local folder) or r2 (Cloudflare R2).
# Serverless hosting must use r2. Default fs.
STORAGE_DRIVER=fs
# With fs: the folder, relative to apps/backend. Default .storage.
STORAGE_FS_PATH=.storage

# With r2: the account (or an explicit S3 endpoint, for other S3-compatible stores),
# an API token limited to the bucket, and the private bucket's name.
# Set R2_ACCOUNT_ID or R2_ENDPOINT.
R2_ACCOUNT_ID=
R2_ENDPOINT=
# Signing region: "auto" for R2. Other S3-compatible stores usually want e.g. us-east-1.
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# With r2, required: the public bucket that holds avatars (and nothing else), and
# the URL it is served from, such as its r2.dev address or a custom domain. The
# same API token must be allowed to write to it. With fs, avatars are kept in
# STORAGE_FS_PATH and served by the API at /api/avatars/.
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=

# ── Running code (docs/specs/07-runner.md) ────────────────────────────────────────

# Where learners' code runs:
#   local   this machine, through Python (development and CI only: isolates nothing;
#           refused in production)
#   http    the bundled runner service (apps/runner), for self-hosting with Docker
#   vercel  Vercel Sandbox microVMs, for the hosted deployment
# Default local outside production; required in production.
RUNNER_PROVIDER=local

# local: the Python interpreter. Blank: packages/runner/.venv from
# `bun run runner:setup`, else python3.
RUNNER_PYTHON=

# http: the runner service's URL, and its shared secret (the same value as the
# runner's RUNNER_TOKEN, at least 32 characters: openssl rand -hex 32).
# Both required when RUNNER_PROVIDER is http. In Docker: http://runner:8798
RUNNER_URL=
RUNNER_TOKEN=

# vercel: the sandbox images in the Vercel Container Registry. Required when
# RUNNER_PROVIDER is vercel. Build and push them with
#   bun run runner:images --platform linux/amd64 --tag-prefix <registry>/ --push
RUNNER_IMAGE_NUMPY=
RUNNER_IMAGE_TORCH=
# vercel: access-token credentials, all three or none. Blank on Vercel, where
# the deployment's OIDC token is used.
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=

# ── Limits (docs/specs/11-security-ops.md §3) ─────────────────────────────────────

# Runs each user may start per UTC day, published by GET /api/v1/config. Runs
# that fail on our side are not counted. Default 100.
RUNS_PER_DAY=100
# Run attempts per user per minute. Default 10.
RUNS_PER_MINUTE=10
# Runs per UTC day across the whole instance; past it, running code pauses
# with 503 until midnight UTC. A spending circuit-breaker. Default 20000.
GLOBAL_RUNS_PER_DAY=20000
# Writes (POST, PATCH, PUT, DELETE under /api/v1) per user per minute. Default 60.
MUTATIONS_PER_MINUTE=60

# Bearer token for /api/internal/* (the daily cleanup). Blank: those endpoints
# do not exist, and the worker process (bun run worker) does the cleanup. On
# Vercel, set it and set CRON_SECRET to the same value so Vercel Cron sends it.
# At least 32 characters: openssl rand -hex 32
INTERNAL_SECRET=

# ── Set by the host, not here ─────────────────────────────────────────────────────
# VERCEL and VERCEL_GIT_COMMIT_SHA are provided by Vercel. The serverless entry
# refuses STORAGE_DRIVER=fs when VERCEL is set.
