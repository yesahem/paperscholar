# Copy to apps/web/.env for local development. Next.js loads it automatically.

# Server-only. Next.js proxies /api/* to this origin; the browser never sees it.
# Must match the backend's PORT (apps/backend/.env).
API_ORIGIN=http://localhost:8797

# Canonical public URL of the site, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
