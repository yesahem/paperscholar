# Copy to apps/web/.env for local development. Next.js loads it automatically.

# Server-only. Next.js proxies /api/* to this origin; the browser never sees it.
# Must match the backend's PORT (apps/backend/.env).
API_ORIGIN=http://localhost:8797

# Canonical public URL of the site, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Only when the backend keeps avatars in R2 (STORAGE_DRIVER=r2): the origin of
# its R2_PUBLIC_URL, such as https://avatars.example.com, so the Content-Security-Policy
# lets pages show them. Read at build time. Leave unset otherwise: with the fs driver
# avatars come from this site.
# AVATAR_ORIGIN=
