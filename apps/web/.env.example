# Copy to apps/web/.env for local development. Next.js loads it automatically.
# The web app holds no secrets; anything prefixed NEXT_PUBLIC_ is public.

# Required. Server-only. Next.js proxies /api/* to this origin; the browser never sees it.
# Must match the backend's PORT (apps/backend/.env).
API_ORIGIN=http://localhost:8797

# Required. Canonical public URL of the site, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Public URL of the CMS (apps/cms), such as http://localhost:3001. When set,
# maintainers see an "Open CMS" link in the account menu. The maintainer screens live
# in the CMS, not here (docs/specs/14-cms.md).
NEXT_PUBLIC_CMS_URL=

# Optional. Only when the backend keeps avatars in R2 (STORAGE_DRIVER=r2): the origin of
# its R2_PUBLIC_URL, such as https://avatars.example.com, so the Content-Security-Policy
# lets pages show them. Read at build time. Leave blank otherwise: with the fs driver
# avatars come from this site.
AVATAR_ORIGIN=

# Optional. Only when the backend keeps files in R2 (STORAGE_DRIVER=r2): the origin of its
# S3 endpoint, such as https://<account>.r2.cloudflarestorage.com, so maintainers'
# browsers may upload PDFs to it directly (the R2 bucket needs a CORS rule allowing PUT
# from this site). Read at build time. Leave blank otherwise: with the fs driver uploads
# go through this site.
UPLOAD_ORIGIN=
