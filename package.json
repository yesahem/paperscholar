{
  "name": "paperimplementation",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:migrate": "turbo run db:migrate",
    "db:generate": "bun run --filter @repo/db db:generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:verify": "bun run --filter @repo/pipeline content:verify",
    "content:sync": "bun run --filter backend content:sync",
    "content:export": "bun run --filter backend content:export",
    "content:status": "bun run --filter backend content:status",
    "api:contract": "postman collection run \"postman/collections/PaperScholar API\" -e postman/environments/local.environment.yaml",
    "runner:setup": "bun run --filter @repo/runner runner:setup"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
