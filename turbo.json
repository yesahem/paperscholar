{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["PATH"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["API_ORIGIN"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "CI",
        "DATABASE_URL",
        "RUNNER_PYTHON",
        "S3_TEST_ENDPOINT",
        "S3_TEST_ACCESS_KEY_ID",
        "S3_TEST_SECRET_ACCESS_KEY",
        "S3_TEST_BUCKET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_URL_DIRECT"]
    }
  }
}
