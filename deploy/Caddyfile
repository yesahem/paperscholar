# The one public entry point of a self-hosted instance (docker-compose.yml).
#
# Caddy replaces any X-Forwarded-For a client sends with the address it sees,
# so the API's per-address sign-in limits count real clients
# (docs/specs/11-security-ops.md §3). With SITE_ADDRESS set to a domain name,
# Caddy also obtains and renews an HTTPS certificate for it.
{$SITE_ADDRESS::80} {
	encode zstd gzip
	reverse_proxy web:3000
}
