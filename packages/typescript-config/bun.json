{
  "$schema": "https://json.schemastore.org/tsconfig",
  "description": "Applications and packages that run on the Bun runtime.",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["bun"],
    "noEmit": true
  }
}
