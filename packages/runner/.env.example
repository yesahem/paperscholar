# Used by the harness tests (bun run test). Copy to packages/runner/.env to override.

# Python interpreter for local runs. Unset: packages/runner/.venv from
# `bun run runner:setup`, else python3 on PATH. It needs pytest, and numpy/torch for
# the problems that use them.
# RUNNER_PYTHON=

# Set by CI providers. When set, tests fail instead of skipping if Python is missing.
# CI=

# runner:adversarial (docs/specs/07-runner.md §10) against a provider that isolates runs.
# --provider http: the bundled runner service and its token (apps/runner/.env.example).
# RUNNER_URL=http://localhost:8798
# RUNNER_TOKEN=
# --provider vercel: the sandbox images in the Vercel Container Registry, built
# with `bun run runner:images --platform linux/amd64 --tag-prefix <registry>/ --push`.
# RUNNER_IMAGE_NUMPY=
# RUNNER_IMAGE_TORCH=
# Vercel access-token credentials. Unset: the OIDC token in VERCEL_OIDC_TOKEN
# (from `vercel env pull`), which the Vercel SDK reads itself.
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# VERCEL_TOKEN=
