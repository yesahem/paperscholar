# Used by db:migrate, db:studio and the database tests.
# Migrations prefer DATABASE_URL_DIRECT, a direct (non-pooled) connection, when it is set.
DATABASE_URL=postgres://paperscholar:paperscholar@localhost:54330/paperscholar
# DATABASE_URL_DIRECT=

# The tests set TZ themselves to prove timestamps survive a host outside UTC, and
# restore whatever value it had. Nothing to configure.
# TZ=
