# Used by db:migrate, db:studio and the database tests. Copy to packages/db/.env.

# Required. Postgres connection string. Points at docker-compose.dev.yml.
DATABASE_URL=postgres://paperscholar:paperscholar@localhost:54330/paperscholar

# Optional. A direct (non-pooled) connection. Migrations and Drizzle Studio prefer it when
# set; blank falls back to DATABASE_URL. Use it when DATABASE_URL points at a pooler.
DATABASE_URL_DIRECT=

# The tests set TZ themselves to prove timestamps survive a host outside UTC, and
# restore whatever value it had. Nothing to configure.
# TZ=
