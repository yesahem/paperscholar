# Used by content:verify and the verification tests. Copy to packages/pipeline/.env to override.

# Python interpreter that runs each problem. Unset: packages/runner/.venv from
# `bun run runner:setup`, else python3 on PATH.
# RUNNER_PYTHON=

# Set by CI providers. When set, the tests fail instead of skipping if Python is missing.
# CI=

# content:verify --provider http: the bundled runner service and its token
# (apps/runner/.env.example).
# RUNNER_URL=http://localhost:8798
# RUNNER_TOKEN=
