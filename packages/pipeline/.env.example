# Used by content:verify and the pipeline tests. Copy to packages/pipeline/.env.

# Postgres for the pipeline's integration tests (each test file creates and drops
# its own database). Unset: those tests are skipped. Matches docker-compose.dev.yml.
DATABASE_URL=postgres://paperscholar:paperscholar@localhost:54330/paperscholar

# Python interpreter that runs each problem. Unset: packages/runner/.venv from
# `bun run runner:setup`, else python3 on PATH.
# RUNNER_PYTHON=

# Set by CI providers. When set, the tests fail instead of skipping if Python is missing.
# CI=

# content:verify --provider http: the bundled runner service and its token
# (apps/runner/.env.example).
# RUNNER_URL=http://localhost:8798
# RUNNER_TOKEN=
